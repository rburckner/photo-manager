# Photo Manager Configuration
# Copy this to .env and adjust values

# Host path to your photos directory (used by docker-compose for volume mount)
PM_HOST_PHOTOS_DIR=/mnt/nas/photos

# NAS mount path (inside the container, or for local dev)
PM_MEDIA_ROOT=/photos

# Database and cache paths
PM_DB_PATH=./data/photos.db
PM_THUMBNAIL_DIR=./data/thumbnails

# Inbox directory for photo ingestion (drop files here)
PM_DROPBOX_DIR=./inbox

# Host path for inbox Docker volume mount (defaults to ./inbox)
PM_HOST_INBOX_DIR=./inbox

# Server
PM_PORT=3000
PM_HOST=0.0.0.0

# Scanner
PM_SCAN_CONCURRENCY=4
PM_SCAN_BATCH_SIZE=50
PM_THUMB_SIZE=400
PM_THUMB_QUALITY=80

# Logging: debug, info, warn, error
PM_LOG_LEVEL=info

# Daily re-index hour (0-23, default 2 AM)
PM_CRON_HOUR=2

# Set to true to allow access from non-private IPs (e.g., via Tailscale)
PM_ALLOW_REMOTE=false
