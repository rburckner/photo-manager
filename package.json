{
  "name": "photo-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "photo-manager": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server/index.js",
    "cli": "tsx src/cli/index.ts",
    "scan": "tsx src/cli/index.ts scan",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "exif-reader": "^2.0.1",
    "fastify": "^5.2.1",
    "@fastify/static": "^8.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "tsx": "^4.19.0",
    "@eslint/js": "^9.16.0",
    "typescript-eslint": "^8.18.0",
    "eslint": "^9.16.0",
    "vitest": "^2.1.0"
  }
}
